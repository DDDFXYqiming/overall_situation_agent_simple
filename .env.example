LLM_MAX_RETRIES=2
LLM_REPORT_ENABLED=false
LLM_REPORT_TIMEOUT_SECONDS=12
LLM_REPORT_MAX_RETRIES=0
LLM_REPORT_MAX_TOKENS=2500

IMPORT_BATCH_SIZE=500
OUTPUTS_DIR=outputs
LOGS_DIR=logs

# Optional local supplementary label mapping file. Keep real local paths out of source code.
